              "        pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
              "    });",
              "    pm.test(\"Response matches Pet schema (OpenAPI components.schemas.Pet)\", function () {",
              "        pm.expect(body, \"response body is not JSON\").to.be.an(\"object\");",
              "        pm.response.to.have.jsonSchema(petSchema);",
              "    });",
              "}",
              "",
              "function checkPetEqualsExpected(body, stepName) {",
              "    pm.test(stepName + \": id equals generated petId\", function () {",
              "        pm.expect(body.id).to.eql(expected.id);",
              "    });",
              "    pm.test(stepName + \": name equals expected\", function () {",
              "        pm.expect(body.name).to.eql(expected.name);",
              "    });",
              "    pm.test(stepName + \": status equals expected\", function () {",
              "        pm.expect(body.status).to.eql(expected.status);",
              "    });",
              "    pm.test(stepName + \": category equals expected\", function () {",
              "        pm.expect(body.category).to.eql(expected.category);",
              "    });",
              "    pm.test(stepName + \": photoUrls equal expected\", function () {",
              "        pm.expect(body.photoUrls).to.eql(expected.photoUrls);",
              "    });",
              "    pm.test(stepName + \": tags equal expected\", function () {",
              "        pm.expect(body.tags).to.eql(expected.tags);",
              "    });",
              "}",
              "// ---- end of helpers ----",
              "",
              "const body = parseJson();",
              "",
              "pm.test(\"Status code is 200 (OpenAPI: getPetById 200 successful operation)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "checkPetResponse(body);",
              "if (body) { checkPetEqualsExpected(body, \"Get after create\"); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet",
            "{{petId}}"
          ]
        },
        "description": "Reads the created pet and compares it with what was sent. OpenAPI: GET /pet/{petId} (getPetById)."
      },
      "response": []
    },
    {
      "name": "3. Update pet",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Change name and status of the same pet; everything else stays as created.",
              "const pet = JSON.parse(pm.collectionVariables.get(\"expectedPet\"));",
              "pet.name = pet.name + \"-updated\";",
              "pet.status = \"sold\";",
              "",
              "pm.collectionVariables.set(\"expectedPet\", JSON.stringify(pet));",
              "pm.collectionVariables.set(\"petBody\", JSON.stringify(pet));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ---- shared helpers ----",
              "const petSchema = JSON.parse(pm.collectionVariables.get(\"petSchema\"));",
              "const expected = JSON.parse(pm.collectionVariables.get(\"expectedPet\") || \"{}\");",
              "",
              "function parseJson() {",
              "    try { return pm.response.json(); } catch (e) { return undefined; }",
              "}",
              "",
              "function checkPetResponse(body) {",
              "    pm.test(\"Content-Type is application/json\", function () {",
              "        pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
              "    });",
              "    pm.test(\"Response matches Pet schema (OpenAPI components.schemas.Pet)\", function () {",
              "        pm.expect(body, \"response body is not JSON\").to.be.an(\"object\");",
              "        pm.response.to.have.jsonSchema(petSchema);",
              "    });",
              "}",
              "",
              "function checkPetEqualsExpected(body, stepName) {",
              "    pm.test(stepName + \": id equals generated petId\", function () {",
              "        pm.expect(body.id).to.eql(expected.id);",
              "    });",
              "    pm.test(stepName + \": name equals expected\", function () {",
              "        pm.expect(body.name).to.eql(expected.name);",
              "    });",
              "    pm.test(stepName + \": status equals expected\", function () {",
              "        pm.expect(body.status).to.eql(expected.status);",
              "    });",
              "    pm.test(stepName + \": category equals expected\", function () {",
              "        pm.expect(body.category).to.eql(expected.category);",
              "    });",
              "    pm.test(stepName + \": photoUrls equal expected\", function () {",
              "        pm.expect(body.photoUrls).to.eql(expected.photoUrls);",
              "    });",
              "    pm.test(stepName + \": tags equal expected\", function () {",
              "        pm.expect(body.tags).to.eql(expected.tags);",
              "    });",
              "}",
              "// ---- end of helpers ----",
              "",
              "const body = parseJson();",
              "",
              "pm.test(\"Status code is 200 (OpenAPI: updatePet 200 Successful operation)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "checkPetResponse(body);",
              "if (body) { checkPetEqualsExpected(body, \"Update\"); }"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pet",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet"
          ]
        },
        "description": "Changes name and status of the same pet. OpenAPI: PUT /pet (updatePet).",
        "body": {
          "mode": "raw",
          "raw": "{{petBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "4. Get pet after update",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ---- shared helpers ----",
              "const petSchema = JSON.parse(pm.collectionVariables.get(\"petSchema\"));",
              "const expected = JSON.parse(pm.collectionVariables.get(\"expectedPet\") || \"{}\");",
              "",
              "function parseJson() {",
              "    try { return pm.response.json(); } catch (e) { return undefined; }",
              "}",
              "",
              "function checkPetResponse(body) {",
              "    pm.test(\"Content-Type is application/json\", function () {",
              "        pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
              "    });",
              "    pm.test(\"Response matches Pet schema (OpenAPI components.schemas.Pet)\", function () {",
              "        pm.expect(body, \"response body is not JSON\").to.be.an(\"object\");",
              "        pm.response.to.have.jsonSchema(petSchema);",
              "    });",
              "}",
              "",
              "function checkPetEqualsExpected(body, stepName) {",
              "    pm.test(stepName + \": id equals generated petId\", function () {",
              "        pm.expect(body.id).to.eql(expected.id);",
              "    });",
              "    pm.test(stepName + \": name equals expected\", function () {",
              "        pm.expect(body.name).to.eql(expected.name);",
              "    });",
              "    pm.test(stepName + \": status equals expected\", function () {",
              "        pm.expect(body.status).to.eql(expected.status);",
              "    });",
              "    pm.test(stepName + \": category equals expected\", function () {",
              "        pm.expect(body.category).to.eql(expected.category);",
              "    });",
              "    pm.test(stepName + \": photoUrls equal expected\", function () {",
              "        pm.expect(body.photoUrls).to.eql(expected.photoUrls);",
              "    });",
              "    pm.test(stepName + \": tags equal expected\", function () {",
              "        pm.expect(body.tags).to.eql(expected.tags);",
              "    });",
              "}",
              "// ---- end of helpers ----",
              "",
              "const body = parseJson();",
              "",
              "pm.test(\"Status code is 200 (OpenAPI: getPetById 200 successful operation)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "checkPetResponse(body);",
              "// Proves the update was persisted, not only echoed back by PUT.",
              "if (body) { checkPetEqualsExpected(body, \"Get after update\"); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
