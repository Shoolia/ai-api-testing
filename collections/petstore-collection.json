          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet",
            "{{petId}}"
          ]
        },
        "description": "Reads the pet again to prove the update was saved. OpenAPI: GET /pet/{petId} (getPetById)."
      },
      "response": []
    },
    {
      "name": "5. Delete pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// OpenAPI: deletePet 200 \"Pet deleted\" — no response body is documented,",
              "// so only the status code is asserted.",
              "pm.test(\"Status code is 200 (OpenAPI: deletePet 200 Pet deleted)\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet",
            "{{petId}}"
          ]
        },
        "description": "Deletes the pet created by this run (clean-up). OpenAPI: DELETE /pet/{petId} (deletePet)."
      },
      "response": []
    },
    {
      "name": "6. Verify deletion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// OpenAPI: getPetById 404 \"Pet not found\". The body for 404 is not documented,",
              "// so only the status code is asserted.",
              "pm.test(\"Deleted pet is not found: status code is 404 (OpenAPI: getPetById 404 Pet not found)\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "// Clean up run-time variables so the next run starts from a clean state.",
              "[\"petId\", \"expectedPet\", \"petBody\"].forEach(function (key) {",
              "    pm.collectionVariables.unset(key);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet",
            "{{petId}}"
          ]
        },
        "description": "The deleted pet must not be found (404). Clears run-time variables. OpenAPI: GET /pet/{petId} (getPetById)."
      },
      "response": []
    }
  ],
